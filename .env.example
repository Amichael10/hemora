# Monorepo env template. Copy to `.env` at this repo root (or use `apps/mobile/.env` for mobile-only overrides).
# Supabase: Dashboard → Project Settings → API

# Mobile (Expo) — required for apps/mobile
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web (Vite) — if you use apps/web with the same project
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
