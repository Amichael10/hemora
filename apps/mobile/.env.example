# Copy to `apps/mobile/.env` (or repo root `.env` — loaded first, then this file overrides).
# Supabase: Dashboard → Project Settings → API

# Prefer EXPO_PUBLIC_* so Metro always inlines them (works on web + native + Expo Go):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# After editing .env, restart Metro with cache clear:
#   pnpm run start:clean          (native / Expo Go)
#   pnpm run web:clean            (browser — use http://127.0.0.1:8081 , not localhost, for Supabase redirects)

# Optional: Expo Go + Google OAuth
# EXPO_PUBLIC_AUTH_REDIRECT=exp://127.0.0.1:8081/--/auth-callback

# Also supported (loaded into app.config `extra` at startup):
# VITE_SUPABASE_URL= / VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL= / SUPABASE_ANON_KEY= / SUPABASE_PUBLISHABLE_KEY=
