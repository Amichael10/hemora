{
  "name": "hemora-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "cd apps/app && pnpm run dev",
    "web:dev": "cd apps/web && pnpm run dev",
    "build": "cd apps/app && pnpm run build",
    "mobile:apk": "cd apps/mobile && pnpm run build:apk",
    "mobile:start": "cd apps/mobile && pnpm run start"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.25.12",
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.24.0",
    "@rollup/rollup-linux-x64-musl": "4.24.0",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.2.4",
    "@tailwindcss/oxide-linux-arm64-musl": "4.2.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.4",
    "@tailwindcss/oxide-linux-x64-musl": "4.2.4",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4"
  },
  "overrides": {
    "@tanstack/react-query": "5.100.9",
    "@tanstack/query-core": "5.100.9",
    "@tanstack/react-router": "1.166.8",
    "@tanstack/react-start": "1.166.18",
    "@tanstack/router-plugin": "1.166.14",
    "@tanstack/router-generator": "1.166.13",
    "@tanstack/start-plugin-core": "1.167.2"
  }
}
